---
import Base from '../layouts/Base.astro';
import Carrusel from '../components/Carrusel.astro';
import { proyectos } from '../data/proyectos.js';
---
<Base>
  <h1 class="oculto">NANDO-GO — Architecture studio in Madrid</h1>
  {proyectos.map((p, i) => (
    <section class="proyecto-fila" aria-labelledby={`p-${p.slug}`}>
      <Carrusel fotos={p.fotos} alt={p.titulo} enlace={`/${p.slug}/`} primeraEager={i === 0} />
      <a class="ficha" href={`/${p.slug}/`}>
        <h2 id={`p-${p.slug}`}>{p.tituloCorto ?? p.titulo}</h2>
        <span>{p.numero}</span>
        <span>{p.año}</span>
      </a>
    </section>
  ))}
</Base>
