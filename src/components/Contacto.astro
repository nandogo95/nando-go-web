---
// Sección CONTACT, al final de la portada: email, teléfono y dirección.
import { estudio } from '../data/proyectos.js';
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(estudio.direccion)}`;
---
<section id="contact" class="seccion contacto" aria-labelledby="titulo-contact">
  <h2 id="titulo-contact" class="seccion-titulo">Contact</h2>
  <dl class="contacto-datos">
    <div>
      <dt>Email</dt>
      <dd><a href={`mailto:${estudio.email}`}>{estudio.email}</a></dd>
    </div>
    <div>
      <dt>Phone</dt>
      <dd><a href={`tel:${estudio.telefono.replace(/\s/g, '')}`}>{estudio.telefono}</a></dd>
    </div>
    <div>
      <dt>Address</dt>
      <dd><a href={mapa} rel="noopener">{estudio.direccion}</a></dd>
    </div>
  </dl>
</section>
