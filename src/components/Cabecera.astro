---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { proyectos } from '../data/proyectos.js';
const { inicio = false } = Astro.props;
const ruta = Astro.url.pathname;
// Menú: HOME / PROJECTS a la izquierda del logo, TEAM / CONTACT a la derecha.
// Cada enlace lleva a su sección de la portada. En la portada, el activo cambia
// según la sección por la que vas (script de abajo); en las demás páginas,
// las de proyecto marcan PROJECTS.
const esProyecto = !inicio && ruta !== '/contact/' && ruta !== '/404/';
const activo = inicio ? 'home' : esProyecto ? 'projects' : '';
const izquierda = [['home', 'Home', '/'], ['projects', 'Projects', '/#projects']];
const derecha = [['team', 'Team', '/#team'], ['contact', 'Contact', '/#contact']];
---
<header class:list={['cabecera', { 'cabecera-inicio': inicio }]}>
  <nav class="nav-grupo nav-izq" aria-label="Main">
    {izquierda.map(([id, texto, href], i) => (
      <>{id === 'projects'
        ? (
          // PROJECTS: al pasar el ratón (o con el teclado) se despliega la lista de proyectos
          <span class="nav-desplegable">
            <a href={href} data-seccion={id} class:list={['nav', { activo: activo === id }]} aria-haspopup="true">{texto}</a>
            <ul class="nav-submenu">
              {proyectos.map((p) => (
                <li><a href={`/${p.slug}/`} aria-current={ruta === `/${p.slug}/` ? 'page' : undefined}>
                  <span class="nav-submenu-num">{p.numero}</span> {p.tituloCorto ?? p.titulo}
                </a></li>
              ))}
            </ul>
          </span>
        )
        : <a href={href} data-seccion={id} class:list={['nav', { activo: activo === id }]}>{texto}</a>}</>
    ))}
  </nav>
  <a href="/" class="cabecera-logo" aria-label="NANDO-GO, home">
    <Image src={logo} alt="" width={150} widths={[150, 300, 600, 1200]} sizes={inicio ? '(max-width: 800px) 80vw, 50vw' : '150px'} loading="eager" />
  </a>
  <nav class="nav-grupo nav-der" aria-label="Studio">
    {derecha.map(([id, texto, href], i) => (
      <><a href={href} data-seccion={id} class:list={['nav', { activo: activo === id }]}>{texto}</a></>
    ))}
  </nav>
</header>

{inicio && (
  <script>
    // Portada: el logo empieza grande en el centro de la pantalla y, al bajar,
    // se encoge hasta su sitio en la cabecera (en la primera pantalla y media de scroll).
    const cab = document.querySelector<HTMLElement>('.cabecera-inicio')!;
    const raiz = document.documentElement;
    const logo = cab.querySelector<HTMLElement>('.cabecera-logo')!;
    const img = logo.querySelector('img')!;
    const intro = document.querySelector<HTMLElement>('.intro');
    const reducir = matchMedia('(prefers-reduced-motion: reduce)');
    const mobil = matchMedia('(max-width: 800px)');
    let base: DOMRect | null = null;
    let pendiente = false;

    // Posición del logo en reposo (sin transformar), en coordenadas de la pantalla.
    function medir() {
      logo.style.transform = 'none';
      base = logo.getBoundingClientRect();
    }

    function pintar() {
      pendiente = false;
      if (!intro || !base || reducir.matches) {
        logo.style.transform = '';
        raiz.style.setProperty('--p', '1');
        return;
      }
      const recorrido = Math.max(1, intro.offsetHeight - innerHeight);
      const p = Math.min(1, Math.max(0, scrollY / recorrido));
      const e = 1 - Math.pow(1 - p, 3); // empieza rápido y frena al llegar
      // Tamaño del logo grande al empezar: 35 % del ancho de pantalla (55 % en móvil)
      const ancho = Math.min(innerWidth * (mobil.matches ? 0.55 : 0.35), innerHeight * 0.525 * (base.width / base.height));
      const escala = Math.max(1, ancho / base.width);
      const dx = innerWidth / 2 - (base.left + base.width / 2);
      const dy = innerHeight / 2 - (base.top + base.height / 2);
      const k = 1 - e;
      logo.style.transform = `translate(${dx * k}px, ${dy * k}px) scale(${1 + (escala - 1) * k})`;
      raiz.style.setProperty('--p', p.toFixed(3));
    }

    // Menú: marca en azul la sección por la que vas. Una sección cuenta como
    // actual cuando su parte de arriba pasa del 45 % de la pantalla; al llegar
    // al final de la página se marca CONTACT.
    const enlaces = [...cab.querySelectorAll<HTMLAnchorElement>('a[data-seccion]')];
    const secciones = ['projects', 'team', 'contact']
      .map((id) => document.getElementById(id))
      .filter((s): s is HTMLElement => !!s);
    let actual = '';
    function marcarSeccion() {
      let id = 'home';
      for (const s of secciones) if (s.getBoundingClientRect().top <= innerHeight * 0.45) id = s.id;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) id = 'contact';
      if (id === actual) return;
      actual = id;
      for (const a of enlaces) {
        const si = a.dataset.seccion === id;
        a.classList.toggle('activo', si);
        if (si) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      }
    }
    addEventListener('scroll', () => requestAnimationFrame(marcarSeccion), { passive: true });
    marcarSeccion();

    const pedir = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); } };
    const recalcular = () => { medir(); pintar(); };

    cab.classList.add('animado');
    recalcular();
    if (!img.complete) img.addEventListener('load', recalcular, { once: true });
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', recalcular);
    reducir.addEventListener('change', recalcular);
  </script>
)}
